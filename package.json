{
  "name": "kkosunnae-backend",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node lib/api/server.js",
    "start:cloudrun": "node lib/api/server.js",
    "migrate:boards": "node lib/scripts/runMigrateBoardsToSupabase.js",
    "evaluate:text-search": "node lib/scripts/evaluateTextSearch.js",
    "test": "npm run build && node --test lib/tests/*.test.js",
    "evaluate:image-search": "node lib/scripts/evaluateImageSearch.js",
    "deploy:local": "bash scripts/deploy-local.sh"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/api/server.js",
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@pinecone-database/pinecone": "^7.0.0",
    "@supabase/supabase-js": "^2.104.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "firebase-admin": "^13.8.0",
    "multer": "^2.1.1",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/multer": "^2.1.0",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "typescript": "^5.7.3"
  },
  "private": true
}
